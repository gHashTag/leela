require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

$RNFirebaseAsStaticFramework = true

use_frameworks! :linkage => :static

platform :ios, '12.4'
install! 'cocoapods', :deterministic_uuids => false

pod 'Firebase', :modular_headers => true
pod 'FirebaseCoreInternal', :modular_headers => true
pod 'GoogleUtilities', :modular_headers => true
pod 'FirebaseStorage', :modular_headers => true
pod 'FirebaseAuthInterop', :modular_headers => true
pod 'FirebaseCore', :modular_headers => true
pod 'FirebaseCoreExtension', :modular_headers => true
pod 'FirebaseAppCheckInterop', :modular_headers => true
pod 'GTMSessionFetcher', :modular_headers => true

target 'leela' do
  config = use_native_modules!

  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => flags[:fabric_enabled],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  
  target 'leelaTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # flipper_post_install(installer)
    
    react_native_post_install(
      installer,
      :mac_catalyst_enabled => false
    )
     
    __apply_Xcode_12_5_M1_post_install_workaround(installer)

    # PurchasesHybridCommon 4.x names `SubscriptionPeriod` unqualified, and a
    # current SDK has StoreKit's own — the lookup is ambiguous and the pod does
    # not compile. Patched after install, because the file is fetched here.
    hybrid = 'Pods/PurchasesHybridCommon/ios/PurchasesHybridCommon/PurchasesHybridCommon/StoreProduct+HybridAdditions.swift'
    if File.exist?(hybrid)
      text = File.read(hybrid)
      fixed = text
        .gsub('subscriptionPeriod: SubscriptionPeriod)', 'subscriptionPeriod: RevenueCat.SubscriptionPeriod)')
        .gsub('subscriptionPeriodUnit: SubscriptionPeriod.Unit)', 'subscriptionPeriodUnit: RevenueCat.SubscriptionPeriod.Unit)')
      File.write(hybrid, fixed) unless fixed == text
    end

    installer.pods_project.targets.each do |target|
        # BoringSSL ships `-GCC_WARN_INHIBIT_ALL_WARNINGS` as a per-file flag,
        # and a current clang reads the leading `-G` as an option it does not
        # have. Firestore pulls it in, so this is between the app and its own
        # database.
        if target.name == 'BoringSSL-GRPC'
          target.source_build_phase.files.each do |file|
            next unless file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS'].split
            flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
            file.settings['COMPILER_FLAGS'] = flags.join(' ')
          end
        end

        target.build_configurations.each do |config|
            config.build_settings['SWIFT_VERSION'] = '5.0'
            # 13.0, not the 12.4 this line used to force on every pod.
            #
            # The app declares 12.4 and ships RevenueCat 4.26.1, whose own
            # minimum is 13.0 — so the declared minimum has been untrue since
            # that dependency was added, and forcing 12.4 onto it made Swift
            # concurrency fail to compile. Raising the pods states what the app
            # already requires; the app target itself is left alone, because
            # lowering somebody's supported iOS version is not a build fix.
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
            # React Native 0.70's Yoga writes `operator"" _pt` with a space,
            # which clang now deprecates — and these pods build with -Werror,
            # so a deprecation from 2023 stops the build in 2026.
            # Two 2023-era deprecations that a 2026 clang raises to errors,
            # inside pods that build with -Werror: Yoga's literal operator and
            # gRPC's `template` keyword without an argument list.
            config.build_settings['WARNING_CFLAGS'] = [
              '$(inherited)',
              '-Wno-deprecated-literal-operator',
              '-Wno-missing-template-arg-list-after-template-kw'
            ]
            # This app is C++17 and a 2026 toolchain defaults higher, where the
            # standard library no longer pulls <exception> in for free.
            config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
            # Boost 1.76 (RN 0.70's own pinned copy) uses `std::unary_function`,
            # which C++17 removed and this libc++ no longer ships at all.
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = [
              '$(inherited)',
              '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION=1',
              'BOOST_NO_CXX98_FUNCTION_BASE=1'
            ]
            if target.name == 'Sentry'
              # `std::set_terminate` and `std::terminate_handler` live there.
              config.build_settings['OTHER_CPLUSPLUSFLAGS'] = ['$(inherited)', '-include', 'exception']
              # And on arm64 with a current SDK, `ucontext64_t` is no longer
              # reachable through Darwin's module map without asking for it.
              config.build_settings['OTHER_CFLAGS'] = ['$(inherited)', '-include', 'sys/_types/_ucontext64.h']
            end
        end
    end
  end
  
end
