{
  "name": "@leela/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Leela on a phone: the board, the die, and the texts — moved by the engine and by nothing else.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.src.json",
    "e2e:build": "APP_VARIANT=development detox build --configuration ios.debug",
    "e2e": "APP_VARIANT=development detox test --configuration ios.debug",
    "prebuild": "APP_VARIANT=development expo prebuild --platform ios --clean"
  },
  "dependencies": {
    "@leela/content": "workspace:*",
    "@leela/engine": "workspace:*",
    "@leela/journal": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@babel/core": "7",
    "@babel/plugin-transform-modules-commonjs": "7",
    "@babel/preset-typescript": "7",
    "@jest/reporters": "29",
    "@types/node": "22.20.1",
    "@types/react": "~19.1.0",
    "babel-jest": "29",
    "detox": "^20.51.4",
    "jest": "29",
    "jest-circus": "29",
    "jest-environment-node": "29",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
